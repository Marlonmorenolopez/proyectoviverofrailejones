# ── Sepolia Testnet ──────────────────────────────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY_AQUI
PRIVATE_KEY=TU_CLAVE_PRIVADA_SIN_0x

# ── OpenWeatherMap (oráculo climático) ───────────────────────
NEXT_PUBLIC_OPENWEATHER_API_KEY=TU_OPENWEATHER_KEY

# ── Contratos ViveroBogota ────────────────────────────────────
NEXT_PUBLIC_CONTRACT_ADDRESS_GANACHE=0x...
NEXT_PUBLIC_CONTRACT_ADDRESS_SEPOLIA=0x...

# ── Contratos Oráculo ─────────────────────────────────────────
NEXT_PUBLIC_ORACLE_ADDRESS_SEPOLIA=0x...

# ── Contratos NFT ─────────────────────────────────────────────
NEXT_PUBLIC_NFT_ADDRESS_GANACHE=0x...
NEXT_PUBLIC_NFT_ADDRESS_SEPOLIA=0x...

# ── Pinata IPFS ───────────────────────────────────────────────
NEXT_PUBLIC_PINATA_JWT=eyJ...
NEXT_PUBLIC_PINATA_API_KEY=TU_PINATA_API_KEY
NEXT_PUBLIC_PINATA_API_SECRET=TU_PINATA_SECRET

# ── Chainlink CRE ─────────────────────────────────────────────
CRE_ETH_PRIVATE_KEY=TU_CLAVE_PRIVADA_SIN_0x

NEXT_PUBLIC_FACTORY_ADDRESS_SEPOLIA=0x...
